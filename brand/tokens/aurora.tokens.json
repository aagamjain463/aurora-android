      "friction": { "$type": "color", "$value": "{color.palette.sun-300}" },
      "cooldown": { "$type": "color", "$value": "{color.palette.glacier-400}" },
      "always-block": { "$type": "color", "$value": "{color.palette.aurora-500}" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Manrope", "$description": "SIL OFL, bundled variable font res/font/manrope.ttf" }
  },
  "typography": {
    "hero-timer": { "$type": "typography", "$value": { "fontSize": "60sp", "lineHeight": "64sp", "fontWeight": 500, "letterSpacing": "-0.04em", "fontFeature": "tnum" } },
    "metric": { "$type": "typography", "$value": { "fontSize": "56sp", "lineHeight": "60sp", "fontWeight": 500, "letterSpacing": "-0.035em", "fontFeature": "tnum" } },
    "display-xl": { "$type": "typography", "$value": { "fontSize": "56sp", "lineHeight": "60sp", "fontWeight": 500, "letterSpacing": "-0.04em" }, "$description": "One-word screen titles: Focus" },
    "display": { "$type": "typography", "$value": { "fontSize": "36sp", "lineHeight": "42sp", "fontWeight": 500, "letterSpacing": "-0.018em" }, "$description": "Hero headlines, two-tone" },
    "headline": { "$type": "typography", "$value": { "fontSize": "26sp", "lineHeight": "32sp", "fontWeight": 620, "letterSpacing": "-0.02em" } },
    "title": { "$type": "typography", "$value": { "fontSize": "19sp", "lineHeight": "25sp", "fontWeight": 620, "letterSpacing": "-0.012em" } },
