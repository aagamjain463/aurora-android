  "material": {
    "$description": "Founder, 2026-11-07: clearly visible, Apple-like glass. 'tint' is the fill over a real backdrop blur (API 31+); 'fallback' is the fill without blur. Backdrop gets saturation 1.35 (vibrancy), then on API 33+ an AGSL lens bends it along the rim. Rim: 1dp light, bright top-left fading round, over a 1dp neutral edge. Sheen: light across the top 55%.",
    "solid-premium": { "use": "cards, rows, fields, forms, charts, timers, Focus, the Shield", "dark": "graphite + 1dp graphite-3 edge", "light": "white + 1dp rule edge" },
    "glass-control": { "use": "secondary buttons, segmented tracks, round icon buttons (no blur: page behind)", "dark": "porcelain 6% + rim + sheen", "light": "white 60% + rim (white top, ink 11% far edge) + sheen white 95% + shadow ink 6% 10dp y+2" },
    "glass-subtle": { "use": "top bar once content scrolls beneath", "blur-dp": 18, "dark": { "tint": "obsidian 55%", "fallback": "obsidian 94%" }, "light": { "tint": "porcelain 60%", "fallback": "porcelain 95%" } },
    "glass-standard": { "use": "floating dock, pinned flow action (float: shadow 28dp, y+10)", "blur-dp": 12, "lens-dp": 14, "dark": { "tint": "graphite 46%", "fallback": "graphite 92%", "rim": "porcelain 55% to 8%", "shadow": "black 55%" }, "light": { "tint": "white 42%", "fallback": "white 90%", "rim": "white 100% to ink 5%", "shadow": "black 18%" } },
    "glass-elevated": { "use": "dialogs; window blur 34dp behind, card see-through when window blur is on", "dark": { "tint": "graphite 70%", "fallback": "graphite 97%" }, "light": { "tint": "white 74%", "fallback": "white 98%" } }
  },
  "touch-target-dp": 48
}