    "body-strong": { "$type": "typography", "$value": { "fontSize": "16sp", "lineHeight": "22sp", "fontWeight": 620 } },
    "secondary": { "$type": "typography", "$value": { "fontSize": "15sp", "lineHeight": "21sp", "fontWeight": 450 } },
    "label": { "$type": "typography", "$value": { "fontSize": "16sp", "lineHeight": "20sp", "fontWeight": 620 } },
    "caption": { "$type": "typography", "$value": { "fontSize": "13sp", "lineHeight": "18sp", "fontWeight": 550 } },
    "eyebrow": { "$type": "typography", "$value": { "fontSize": "13sp", "lineHeight": "16sp", "fontWeight": 650, "letterSpacing": "0.04em" } },
    "wordmark": { "$type": "typography", "$value": { "fontSize": "24sp", "lineHeight": "28sp", "fontWeight": 500, "letterSpacing": "-0.01em" } }
  },
  "space": {
    "xxs": { "$type": "dimension", "$value": "4dp" },
    "xs": { "$type": "dimension", "$value": "8dp" },
    "s": { "$type": "dimension", "$value": "12dp" },
    "m": { "$type": "dimension", "$value": "16dp" },
    "l": { "$type": "dimension", "$value": "24dp" },
    "xl": { "$type": "dimension", "$value": "32dp" },
    "xxl": { "$type": "dimension", "$value": "48dp" },
    "gutter": { "$type": "dimension", "$value": "24dp" },
    "card-inset": { "$type": "dimension", "$value": "16dp", "$description": "Cards sit 16dp from the screen edge" }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "12dp" },
    "m": { "$type": "dimension", "$value": "18dp" },
    "l": { "$type": "dimension", "$value": "26dp", "$description": "Cards" },
    "dialog": { "$type": "dimension", "$value": "30dp" },
    "pill": { "$type": "dimension", "$value": "50%" }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "$description": "One curve everywhere: quick to respond, slow to settle" },
    "quick": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "gentle": { "$type": "duration", "$value": "420ms" },
    "reveal": { "$type": "duration", "$value": "900ms", "$description": "Hero art and metrics fading up on first show" },
    "breath": { "$type": "duration", "$value": "4200ms" }
  },
  "art": {
    "immersive": { "$type": "other", "$value": { "asset": "first_light_cinematic (dark) / first_light_day (light)", "height": "440dp", "alignment": "bias 0.42, -0.2" }, "$description": "Today, Focus, Shield and Intent, onboarding welcome and finish" },
    "balanced": { "$type": "other", "$value": { "asset": "first_light_cinematic (dark) / first_light_day (light)", "height": "360dp", "alignment": "bias 0.42, -0.45" }, "$description": "Protect, Insights" },
    "restrained": { "$type": "other", "$value": { "asset": "none: palette, hairlines and mark only" }, "$description": "Settings, schedules, pickers, forms" }
  }
