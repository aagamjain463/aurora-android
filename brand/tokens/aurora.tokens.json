      "text-tertiary": { "$type": "color", "$value": "{color.palette.ink-60}" },
      "accent": { "$type": "color", "$value": "{color.palette.aurora-700}" },
      "sun": { "$type": "color", "$value": "{color.palette.sun-700}" },
