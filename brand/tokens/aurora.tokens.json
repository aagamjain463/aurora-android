        "danger": "{color.palette.signal-dark}"
      },
      "light": {
        "background": "{color.palette.porcelain}",
        "surface": "{color.palette.white}",
        "elevated": "{color.palette.paper-2}",
        "field": "{color.palette.paper-2}",
        "border": "{color.palette.rule}",
        "border-strong": "{color.palette.fog}",
        "text-primary": "{color.palette.ink}",
        "text-secondary": "{color.palette.stone}",
