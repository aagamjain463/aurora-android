+    /// derives the same value from the verified Firebase UID (appAccountToken in server/src/apple.js) and accepts no other.
     nonisolated static func accountToken(_ uid: String) -> String {
         var b = Array(SHA256.hash(data: Data(uid.utf8)).prefix(16))
