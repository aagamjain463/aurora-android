-#!/bin/zsh
-# Runs the account service's own tests plus the App Store route, against a scratch copy of aurora-android/server with
-# apple-verify.js added. Nothing in the Android repository changes and nothing is deployed.
-# usage: server-patches/run-tests.sh [path-to-aurora-android]
-set -e
-here=${0:A:h}; android=${1:-$here/../../aurora-android}
-tmp=$(mktemp -d); trap 'rm -rf $tmp' EXIT
-cp -R $android/server/{src,test,migrations,package.json} $tmp/
-python3 -I - "$here/apple-verify.js" "$tmp/src/worker.js" <<'PY'
-import sys
-patch, worker = open(sys.argv[1]).read(), open(sys.argv[2]).read()
-marker = 'const ROUTES = {'
-assert marker in worker
-worker = worker.replace(marker, patch + '\n' + marker + "\n  '/v1/verify/apple': verifyApple,", 1)
-open(sys.argv[2], 'w').write(worker)
-PY
-cp $here/test/*.test.js $tmp/test/
-cd $tmp && node --test test/
