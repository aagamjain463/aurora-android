    <!-- System: Accessibility settings -->
    <string name="shield_service_label">aurora Shield</string>
    <string name="shield_service_description">Shield steps in when an app you chose to protect opens. aurora reads only the name of the app in front. It doesn\'t read your screen or what you type, and nothing leaves your phone. Turn it off here at any time.</string>
    <string name="content_service_label">aurora Web &amp; content Shield</string>
    <string name="content_service_description">Optional. Lets aurora pause websites you protect in supported browsers, and leave YouTube Shorts or Instagram Reels if you turned that on. It reads the address shown in the browser\'s address bar and the names of on-screen elements in those apps. It doesn\'t read messages, passwords or what you type, it doesn\'t store or send anything, and nothing leaves your phone. Turn it off here at any time.</string>

