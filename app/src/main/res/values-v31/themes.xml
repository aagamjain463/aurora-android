<resources>
    <style name="Theme.Aurora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aurora_window</item>
        <!-- Android 12+ splash: the approved symbol forms on the midnight green of its master; AuroraUnveil carries it on. -->
        <item name="android:windowSplashScreenBackground">@color/aurora_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_first_light</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>

    <!-- With reduced motion: the finished symbol, still. The system remembers it for the next launch. -->
    <style name="Theme.Aurora.StillSplash">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_symbol</item>
    </style>
</resources>
