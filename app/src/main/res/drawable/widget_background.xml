<?xml version="1.0" encoding="utf-8"?>
<!-- Night surface lit faintly from the top edge, like auroraSurface in the app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/widget_bottom"
        android:startColor="@color/widget_top" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_edge" />
</shape>
