<?xml version="1.0" encoding="utf-8"?>
<!-- The Aurora symbol, "First Light": a ring of light resting on the horizon and a point of light rising
     above it. 24-unit grid (brand/tools/logo.py) at 2.4x, centred in the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft light behind the ring, so the symbol glows the way the First Light artwork does. -->
    <path android:pathData="M54,71.28m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="71.28"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#33F3C77D" android:offset="0" />
                <item android:color="#143FC495" android:offset="0.55" />
                <item android:color="#003FC495" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M36,71.28 A18,18 0 0,1 72,71.28"
        android:strokeWidth="7.2"
        android:strokeLineCap="butt">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="72"
                android:endY="53.28"
                android:startX="36"
                android:startY="71.28"
                android:type="linear">
                <item android:color="#FF2FB883" android:offset="0" />
                <item android:color="#FF8BE8BF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFF3C77D"
        android:pathData="M54,40.08m-4.8,0a4.8,4.8 0,1 1,9.6 0a4.8,4.8 0,1 1,-9.6 0" />
</vector>
