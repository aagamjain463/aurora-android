<?xml version="1.0" encoding="utf-8"?>
<!-- The widget: the logo, what is protecting you, and a countdown when it has an end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    tools:ignore="UnusedAttribute,UseCompoundDrawables"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/aurora_logo" />

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:letterSpacing="0"
                android:maxLines="1"
                android:textColor="@color/widget_eyebrow"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/widget_text"
        android:textSize="30sp"
        android:visibility="gone" />
</LinearLayout>
