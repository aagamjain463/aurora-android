<?xml version="1.0" encoding="utf-8"?>
<!-- Behavioural data never goes to cloud backup. Phone-to-phone transfer (user-initiated, local) is allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
