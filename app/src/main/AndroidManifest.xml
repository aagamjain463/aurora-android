<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage access: granted by the user in system Settings, only to power on-device Insights. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets aurora list the apps a person can open from their launcher, without QUERY_ALL_PACKAGES,
         and recognise the home screen so it isn't counted as screen time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Shield never covers Settings, whichever package the device maker uses for it. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".AuroraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aurora">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Shield: its own task, out of Recents, so finishing it never reveals the protected app. -->
        <activity
            android:name=".protect.ShieldActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.aurora.shield"
            android:theme="@style/Theme.Aurora.Shield" />

        <!-- Only the person can turn this on, in Android's Accessibility settings. It reads the name of
             the app in front and nothing else (res/xml/shield_service.xml). -->
        <service
            android:name=".protect.ShieldService"
            android:exported="true"
            android:label="@string/shield_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shield_service" />
        </service>

        <!-- Optional and separate from Shield: websites in supported browsers, and Shorts/Reels. Only the
             person turns it on, after aurora's own disclosure (res/xml/content_service.xml). -->
        <service
            android:name=".protect.ContentService"
            android:exported="true"
            android:label="@string/content_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/content_service" />
        </service>
    </application>
</manifest>
