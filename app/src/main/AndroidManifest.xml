<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage access: granted by the user in system Settings, only to power on-device Insights. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- The ongoing notification while protection runs (Android 13+ asks the person first), shown as a
         Live Update on Android 16. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- A strict commitment continues after a restart: aurora starts again as soon as the phone does. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Aurora has no network access. Google Play Billing brings Google's datatransport library, which
         asks for these to upload billing-library diagnostics; they're removed so nothing leaves the phone.
         Purchases still go through the Play Store app over IPC. Verify with license testers before launch
         (docs/PRODUCT.md, "Billing"). -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Lets aurora list the apps a person can open from their launcher, without QUERY_ALL_PACKAGES,
         and recognise the home screen so it isn't counted as screen time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Shield never covers Settings, whichever package the device maker uses for it, except to lock it
             while a strict commitment runs (protect/Exemptions.kt lockedPackages). -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".AuroraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aurora">
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the person can turn this on, in Android's Accessibility settings. It reads the name of
             the app in front and nothing else (res/xml/shield_service.xml). -->
        <service
            android:name=".protect.ShieldService"
            android:exported="true"
            android:label="@string/shield_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shield_service" />
        </service>

        <!-- Optional and separate from Shield: websites in supported browsers, and Shorts/Reels. Only the
             person turns it on, after aurora's own disclosure (res/xml/content_service.xml). -->
        <service
            android:name=".protect.ContentService"
            android:exported="true"
            android:label="@string/content_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/content_service" />
        </service>

        <!-- After a restart, and whenever the date or time is changed (protect/TrustedClock.kt). -->
        <receiver
            android:name=".protect.StrictReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Uninstall protection, turned on by the person (protect/UninstallGuard.kt). No policies. -->
        <receiver
            android:name=".protect.UninstallGuard"
            android:exported="true"
            android:label="@string/admin_label"
            android:description="@string/admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: what is protecting the person now, counting down by itself. -->
        <receiver
            android:name=".AuroraWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aurora_widget_info" />
        </receiver>

        <!-- Quick Settings tile: lit while protection runs; a tap opens Aurora. -->
        <service
            android:name=".AuroraTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_aurora"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
